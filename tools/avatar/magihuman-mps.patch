+def sdpa_attn_func(query: torch.Tensor, key: torch.Tensor, value: torch.Tensor) -> torch.Tensor:
+    """FlashAttention-compatible attention on PyTorch SDPA.
+
+    Inputs are [batch, seqlen, heads, head_dim]; key/value may have fewer heads (grouped-query
+    attention), as flash_attn_func accepts. Heads are processed in chunks to bound the size of the
+    attention matrix on backends without a fused kernel.
+    """
+    batch, seqlen_q, num_heads_q, head_dim = query.shape
+    num_heads_kv = key.shape[2]
+    group = num_heads_q // num_heads_kv
+    q = query.transpose(1, 2)
+    k = key.transpose(1, 2)
+    v = value.transpose(1, 2)
+    out = torch.empty_like(q)
+    for start in range(0, num_heads_q, SDPA_HEAD_CHUNK):
+        end = min(start + SDPA_HEAD_CHUNK, num_heads_q)
+        kv_index = torch.arange(start, end, device=q.device) // group
+        out[:, start:end] = torch.nn.functional.scaled_dot_product_attention(
+            q[:, start:end], k[:, kv_index], v[:, kv_index]
+        )
+    return out.transpose(1, 2)
+
