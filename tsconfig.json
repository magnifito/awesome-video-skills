{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"], "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [
    "packages/**/*",
    "adapters/**/*",
    "tools/**/*",
    "evaluations/**/*",
    "showcase/**/*.ts",
    "site/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
